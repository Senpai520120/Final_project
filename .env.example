# Environment variables read by config/settings.py.
# Django does not load this file automatically: set the variables in your
# shell or hosting platform. Without them, safe-for-local-development defaults
# are used.

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# "True" for local development, "False" in production.
DJANGO_DEBUG=True
